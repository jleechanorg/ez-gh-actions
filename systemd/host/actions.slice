# Host-docker contract: actions 28G, agents 12G, automation 5G, QEMU 10G.
# These are policy ceilings, not a current live-health measurement.

[Unit]
Description=Host aggregate boundary for GitHub Actions runner containers
Before=slices.target

[Slice]
MemoryHigh=26G
MemoryMax=28G
MemorySwapMax=0
TasksMax=8000
CPUQuota=2000%
IOWeight=25
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=80%
ManagedOOMSwap=auto

[Install]
WantedBy=slices.target
