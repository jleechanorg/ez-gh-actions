# automation.slice — finite budget for orchestration/watchdog automation.
# measured margin: MemoryHigh=4608M (4.5 GiB) soft throttle provides measured margin
# below the MemoryMax=5G hard ceiling, bounding transient worker scopes while
# preventing unbounded host memory consumption.
[Unit]
Description=Automation and dark-factory processes — bounded host budget
Before=slices.target

[Slice]
MemoryHigh=4608M
MemoryMax=5G
MemorySwapMax=1G
TasksMax=4096
MemoryAccounting=yes
ManagedOOMMemoryPressure=auto
ManagedOOMSwap=auto
