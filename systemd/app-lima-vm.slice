# app-lima-vm.slice — budget template for the Colima/Lima VM QEMU process.
# Part of bead jleechan-aqh (apply and verify limits against the actual QEMU cgroup).
#
# Lima may place the VM in an escaped transient application slice rather than
# this hierarchical unit. The canonical enforcement therefore also lives in
# systemd/lima-vm@colima.service.d/99-memory-ceiling.conf, which install.sh
# deploys directly on the service. Keep both values identical.
#
# MemoryHigh provides the first response (throttle + reclaim under pressure);
# MemoryMax is a finite final containment boundary for a runaway VM. This
# ordering preserves normal operation while preventing unbounded host impact.
#
# 34 GiB was measured against a 31.8 GiB normal QEMU RSS peak, leaving a
# measured margin of 2.2 GiB before reclaim. MemoryMax=38G is 6.2 GiB above that peak;
# the finite swap/task ceilings bound transient accounting and fork growth.
#
# Installation (no sudo, user-scope):
#   cp systemd/app-lima-vm.slice ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user restart lima-vm@colima.service
# Then verify:
#   cat /sys/fs/cgroup/user.slice/user-1000.slice/user@1000.service/app.slice/app-lima\\x2dvm.slice/lima-vm@colima.service/memory.high
# should print 36507222016 (= 34 GiB).

[Unit]
Description=Colima/Lima VM QEMU process slice — enforced memory ceiling (34 GiB)
Before=slices.target

[Slice]
MemoryHigh=34G
MemoryMax=38G
MemorySwapMax=2G
TasksMax=4096
MemoryAccounting=yes
