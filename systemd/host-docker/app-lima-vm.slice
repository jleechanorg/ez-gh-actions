# app-lima-vm.slice — host-docker QEMU ceiling.
# Host Docker keeps runners under actions.slice; the Colima VM uses an 8 GiB
# guest. The limits reserve space above the guest allocation for QEMU.
# MemoryMax=10G bounds the guest and QEMU overhead. Keep these values aligned
# with systemd/host-docker/lima-vm@colima.service.d/99-memory-ceiling.conf.

[Unit]
Description=Colima/Lima VM QEMU process slice — host-docker memory ceiling (10 GiB)
Before=slices.target

[Slice]
MemoryHigh=9G
MemoryMax=10G
MemorySwapMax=2G
TasksMax=4096
MemoryAccounting=yes
CPUAccounting=yes
CPUQuota=1600%
