# agents.slice — user-scope memory ceiling for interactive agent CLI processes
# (claude/codex/cursor/gemini/etc) and their MCP descendants. Orchestration
# daemons use the separate automation.slice.
#
# measured margin (2026-10-03, jeff-ubuntu): 17.6 GiB current of which
# 10.8 GiB anon (the rest reclaimable page cache), 18.3 GiB peak. The
# 2026-10-03 operator decision (bead ez-gh-actions-154k: cap agent sessions,
# keep runners) lowered 18G/20G to MemoryHigh=10G, MemoryMax=12G so that
# actions 28G + agents 12G + automation 5G + VM 10G + 10% reserve fit the
# 61.9 GiB host. 13G reclaims page cache first; anon keeps 2.2 GiB headroom.
#
# Static syntax validation only: `systemd-analyze verify systemd/agents.slice`

[Unit]
Description=Interactive agent CLI processes (claude/codex/cursor/etc) — finite memory budget
Before=slices.target

[Slice]
MemoryHigh=10G
MemoryMax=12G
MemorySwapMax=2G
TasksMax=8192
MemoryAccounting=yes
ManagedOOMMemoryPressure=auto
ManagedOOMSwap=auto
