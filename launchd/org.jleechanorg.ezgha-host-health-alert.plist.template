<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.jleechanorg.ezgha-host-health-alert</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@SCRIPTS_DIR@/ezgha-host-health-alert.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOME@/bin:@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DOCKER_HOST</key>
    <string>unix://@HOME@/.colima/default/docker.sock</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>@HOME@</string>

  <key>StandardOutPath</key>
  <string>/tmp/ezgha-host-health-alert.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/ezgha-host-health-alert.log</string>

  <key>StartInterval</key>
  <integer>120</integer>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
