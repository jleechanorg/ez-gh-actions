# MacBook fleet — 4 runners, Colima-backed docker.
# Colima VM must be 8 CPU / 22 GiB (colima start --cpu 8 --memory 22):
# 4 x runner_floor_mb (3072) + guest_reserve_mb (2048) = 14336 MB.
# Install: cp config/config.toml.mac.example ~/.config/ezgha/config.toml
version = 1

[github]
scope = "org"
target = "jleechanorg"

[runner]
labels = ["self-hosted", "self-hosted-mikey", "ezgha", "macOS", "ARM64"]
# DISABLED 2026-11-18: Mac docker fleet suspended by operator instruction - the four
# runner containers were consuming ~200% CPU on the host (Colima VM at 233%, load avg 546,
# 20k threads) while competing with active cmux agent lanes. Suspension record: bead
# jleechan-hxz0 (the DISABLED-not-DOWN declaration) - set count = 4 and re-declare with
# EZGHA_SUSPENSION_RECORD to restore. Do NOT infer this opt-out from live docker state.
count = 0
image = "ezgha-runner:latest"
name_prefix = "ez-mac-runner-h"
guest_reserve_mb = 2048
# Opt-in shared pip wheelhouse (bead jleechan-93cf): mounted read-only into
# every runner container at /opt/wheelhouse with PIP_FIND_LINKS pointed at
# it, so pip installs stop writing their whole download into the ephemeral
# container's writable overlay layer every job. Populate the directory
# yourself (e.g. `pip download -r requirements.txt -d <dir>` on a schedule);
# if the path doesn't exist the mount is silently skipped (fail-open).
#
# CRITICAL on Colima/Mac: this path MUST live under one of Colima's
# configured virtiofs mounts (check `colima ssh -- mount | grep virtiofs`
# for the current allowlist -- e.g. ~/.cache, ~/Library/Caches/colima,
# ~/.local/share/worldarchitect-runners). A path OUTSIDE that allowlist
# does NOT fail loudly: `docker run -v <unmounted-host-path>:...` silently
# bind-mounts an empty phantom directory instead (confirmed live,
# 2026-07-17/18) -- the daemon's own is_dir() check on the HOST side still
# passes (the real directory exists on macOS), so the mount is attempted,
# but PIP_FIND_LINKS ends up pointing at an empty dir inside the container
# and pip quietly falls through to a normal network download, looking
# "configured" while doing nothing. Use a subdirectory of ~/.cache, not an
# arbitrary path like ~/.ezgha/wheelhouse.
# wheelhouse_host_path = "/Users/jleechan/.cache/ezgha-wheelhouse"

# Opt-in host-side bare git mirrors: mounted read-only into every runner
# container at /opt/ezgha-git-mirrors with EZGHA_GIT_MIRRORS pointed at it,
# so shallow git fetches hydrate objects locally instead of downloading full
# packfiles over the network every job (fail-open if absent). Warmed on a
# schedule by scripts/refresh_runner_caches.sh (org.jleechanorg.ezgha-cache-warm).
#
# CRITICAL on Colima/Mac: same virtiofs-allowlist requirement as
# wheelhouse_host_path above -- use a subdirectory of ~/.cache, not an
# arbitrary path.
# git_mirror_host_path = "/Users/jleechan/.cache/ezgha-git-mirrors"

# Opt-in host-side npm cache: mounted read-only into every runner container at
# /opt/ezgha-npm-cache with EZGHA_NPM_CACHE pointed at it (fail-open if absent).
# Warmed on a schedule by scripts/refresh_runner_caches.sh (org.jleechanorg.ezgha-cache-warm).
#
# CRITICAL on Colima/Mac: same virtiofs-allowlist requirement as
# wheelhouse_host_path above -- use a subdirectory of ~/.cache, not an
# arbitrary path.
# npm_cache_host_path = "/Users/jleechan/.cache/ezgha-npm-cache"

# Opt-in per-runner job workspace (bead jleechan-93cf): mounted read-write
# into each container at /home/runner/_work (the actions/runner default
# workspace root) at {workspace_host_path}/{runner_name}, so checkouts,
# dependency installs, and build/test scratch land on host-visible,
# trim-eligible disk instead of the ephemeral writable overlay layer. The
# daemon wipes each runner's subdirectory immediately before every container
# start, so no job ever sees a prior job's checkout, build output, or
# credentials. If the parent path doesn't exist the mount is silently
# skipped (fail-open), same as the wheelhouse above.
#
# CRITICAL on Colima/Mac: same virtiofs-allowlist requirement as
# wheelhouse_host_path above -- use a subdirectory of ~/.cache, not an
# arbitrary path.
# workspace_host_path = "/Users/jleechan/.cache/ezgha-workspace"

[limits]
memory_mb = 3072
cpus = 1.0
pids = 512
min_free_disk_gb = 30
# Opt-in (bead jleechan-5khv): see config.toml.linux.example for the full
# explanation. Docker's built-in seccomp profile denies clone(CLONE_NEWUSER),
# which makes `unshare -Urn` fail `Operation not permitted` in the runner
# container. Both settings default OFF (hardened profile preserved).
# seccomp_profile = "/etc/ezgha/seccomp-userns.json"
# allow_userns = false

[policy]
# Colima = docker-in-VM, but backend isolation is still "container".
# Do NOT set "vm" here — serve fail-closes on daemon blips.
minimum_isolation = "container"

[queue_monitor]
enabled = false
