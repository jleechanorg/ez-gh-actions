# Cloud microVM runner host (cmux Cloud / any native-Docker VM).
#
# The daemon's Docker runs *inside* this VM on this VM's own kernel, so there is
# no separate bare-metal host to bound with `actions.slice`. The VM itself is the
# isolation boundary: `host_containment = "vm"` tells containment admission to
# treat the machine as VM-contained. That declaration is only honored when the
# CPU actually reports virtualization; on bare metal `serve` refuses to start.
#
# Install: cp config/config.toml.cloud-vm.example ~/.config/ezgha/config.toml
# See docs/cloud-vm-hosts.md and scripts/cloud/bootstrap-cloud-vm-host.sh.
version = 1

[github]
scope = "org"
target = "jleechanorg"

[runner]
name_prefix = "ez-cloud-runner"
labels = ["self-hosted", "self-hosted-mikey", "ezgha", "Linux", "X64", "cmux-cloud"]
# Size the count to the VM: `runner_floor_mb` (3072 default) per runner plus host
# headroom. 4 on a 16 GiB / 8 vCPU machine, 2 on an 8 GiB / 4 vCPU machine.
count = 4
image = "ezgha-runner:latest"
# The 4 GiB Lima guest reserve is too big here (the daemon's Docker *is* this VM's
# Docker), but zero is wrong too: dockerd, the guest OS and the daemon itself still
# need memory. 512 MiB keeps `count x runner_floor_mb` inside the budget:
#   (16203 - 512) / 1400 = 11 runners on 16 GiB, (8011 - 512) / 1400 = 5 on 8 GiB.
guest_reserve_mb = 512
# Per-runner reservation used by the budget check (see docs/cloud-vm-hosts.md).
# 1400 is the per-job figure the 20-runner Linux fleet runs; the default of 3072
# would cap a 16 GiB host at 4 runners. Keep this in step with the docs.
runner_floor_mb = 1400

[limits]
memory_mb = 1400
cpus = 1.6
pids = 512
min_free_disk_gb = 10

[policy]
minimum_isolation = "container"
host_containment = "vm"

[queue_monitor]
enabled = false

[canary]
enabled = false

[invariant_sampler]
enabled = false
