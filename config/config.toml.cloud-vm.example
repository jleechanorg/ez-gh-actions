# Cloud microVM runner host (cmux Cloud / any native-Docker VM).
#
# The daemon's Docker runs *inside* this VM on this VM's own kernel, so there is
# no separate bare-metal host to bound with `actions.slice`. The VM itself is the
# isolation boundary: `host_containment = "vm"` tells containment admission to
# treat the machine as VM-contained. That declaration is only honored when the
# CPU actually reports virtualization; on bare metal `serve` refuses to start.
#
# Install: cp config/config.toml.cloud-vm.example ~/.config/ezgha/config.toml
# See docs/cloud-vm-hosts.md and scripts/cloud/bootstrap-cloud-vm-host.sh.
version = 1

[github]
scope = "org"
target = "jleechanorg"

[runner]
name_prefix = "ez-cloud-runner"
labels = ["self-hosted", "self-hosted-mikey", "ezgha", "Linux", "X64", "cmux-cloud"]
# Deliberately conservative starting point. With the 512/1400 values below the
# ceiling is 11 on a 16 GiB / 8 vCPU host and 5 on an 8 GiB / 4 vCPU host
# (docs/cloud-vm-hosts.md). Raise it only after reading that formula.
count = 4
image = "ezgha-runner:latest"
# The 4 GiB Lima guest reserve is too big here (the daemon's Docker *is* this VM's
# Docker), but zero is wrong too: dockerd, the guest OS and the daemon itself still
# need memory. 512 MiB keeps `count x runner_floor_mb` inside the budget:
#   (16203 - 512) / 1400 = 11 runners on 16 GiB, (8011 - 512) / 1400 = 5 on 8 GiB.
guest_reserve_mb = 512
# Per-runner reservation used by the budget check (see docs/cloud-vm-hosts.md).
# 1400 is the per-job figure the 20-runner Linux fleet runs. With the code defaults
# (runner_floor_mb = 3072, guest_reserve_mb = 4096) a 16 GiB host caps at 3 runners.
# Keep this in step with docs/cloud-vm-hosts.md.
runner_floor_mb = 1400
# Per-job workspace bind: job checkouts and build scratch land in this host
# directory (wiped before every container start) instead of accumulating in the
# container's writable overlay layer.
#
# Why this is not optional on a cloud VM: without it every concurrent job writes
# its checkout + node_modules/build output into the container overlay, so a
# 4-5 runner host on a 32 GB volume drifts 3-10 GB of free space per job churn and
# admission (min_free_disk_gb) pauses and resumes repeatedly. Measured 2026-11-16 on
# a 32 GB / 4 vCPU / 5-runner cmux VM: container writable layers reached 7.1 GB
# across 5 containers with no workspace bind.
#
# Cost, stated plainly: setting this also sets EZGHA_VIRTIOFS_WORKSPACE=1 on the
# container (see src/docker_backend.rs), which makes the image's tar wrapper guard
# every extraction under /home/runner/_work via mirror-then-sync. That path is
# correct on any filesystem, but it mirrors the pre-existing destination tree per
# extraction, so it is slower than a plain tar. On native-Docker VMs (no virtiofs)
# the symlink-corruption bug it guards against does not exist, so the bind is
# purely a disk-churn win; keep it for the disk behaviour, not for the wrapper.
#
# MUST be an absolute path. The daemon uses std::path::Path::new().is_dir()
# directly, which does NOT expand `~`, `$HOME`, or environment variables — a
# relative or tilde path silently evaluates to not-a-directory and the bind is
# skipped without error. Bootstrap creates this directory and rewrites the value
# for the actual host user (scripts/cloud/bootstrap-cloud-vm-host.sh).
workspace_host_path = "/home/cmux/.cache/ezgha-workspace"

[limits]
memory_mb = 1400
cpus = 1.6
pids = 512
min_free_disk_gb = 10

[policy]
minimum_isolation = "container"
host_containment = "vm"

[queue_monitor]
enabled = false

[canary]
enabled = false

[invariant_sampler]
enabled = false
