# jeff-ubuntu fleet — approved 14-runner profile (10-runner rollback also supported).
# Install: cp config/config.toml.linux.example ~/.config/ezgha/config.toml
version = 1

[github]
scope = "org"
target = "jleechanorg"

[runner]
name_prefix = "ez-runner-c"
labels = ["self-hosted", "self-hosted-mikey", "ezgha", "Linux", "X64"]
count = 14
image = "ezgha-runner:latest"
# Keep the existing VM and host memory envelope; 14 × 2000 MiB remains below
# the 32768 MiB guest budget after its 4096 MiB reserve.
vm_total_mb = 36864
guest_reserve_mb = 4096
# Reserve 8 GiB of the existing 62.8 GiB physical host for the host OS and
# non-runner services. The configured VM total must fit below this envelope.
host_reserve_mb = 8192

[limits]
memory_mb = 2000
cpus = 2.0
pids = 512
min_free_disk_gb = 10
cgroup_parent = "actions.slice"

[policy]
# Native linux docker = container isolation. "vm" only if daemon is VM-contained
# and you want fail-closed enforcement when backend drops below vm.
minimum_isolation = "container"

# Local start failures collapse inward before they can become a fleet or VM
# restart storm. Open one slot after 3 failures in 10 minutes; pause all new
# admission only after 3 distinct slot circuits are open. Existing jobs keep
# running, and these circuits never stop Colima or the physical host.
[failure_ladder]
slot_failure_threshold = 3
slot_failure_window_secs = 600
slot_cooldown_secs = 900
fleet_open_slot_threshold = 3
fleet_cooldown_secs = 600

# Read-only auxiliary observers stay opt-in on Linux so they cannot compete
# with the core serve reconciliation loop or become host-pressure voters.
[queue_monitor]
enabled = false

[canary]
enabled = false

[invariant_sampler]
enabled = false
