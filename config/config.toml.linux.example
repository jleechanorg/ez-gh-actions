# jeff-ubuntu fleet — approved 20-runner profile (14-runner and 10-runner rollback also supported).
# Install: cp config/config.toml.linux.example ~/.config/ezgha/config.toml
version = 1

[github]
scope = "org"
target = "jleechanorg"

[runner]
name_prefix = "ez-runner-c"
labels = ["self-hosted", "self-hosted-mikey", "ezgha", "Linux", "X64"]
count = 20
image = "ezgha-runner:latest"
# Opt-in shared pip wheelhouse: mounted read-only into every runner container at
# /opt/wheelhouse with PIP_FIND_LINKS pointed at it (fail-open if absent).
# Warmed on a schedule by scripts/refresh_runner_caches.sh (ezgha-cache-warm.timer).
# wheelhouse_host_path = "/home/jleechan/.cache/ezgha-wheelhouse"
# Opt-in host-side bare git mirrors: mounted read-only into every runner container at
# /opt/ezgha-git-mirrors with EZGHA_GIT_MIRRORS pointed at it (fail-open if absent).
# Warmed on a schedule by scripts/refresh_runner_caches.sh (ezgha-cache-warm.timer).
# git_mirror_host_path = "/home/jleechan/.cache/ezgha-git-mirrors"
# The legacy vm_total_mb field pins the native actions.slice pool to 28 GiB.
# Docker/OS overhead and the separate QEMU VM are outside this runner pool.
vm_total_mb = 28672
guest_reserve_mb = 0
runner_floor_mb = 1400
# Retain the host-headroom check; the canonical containment assertion separately
# checks all four hard caps (55 GiB) plus max(2 GiB, 10% of host RAM) reserve.
host_reserve_mb = 8192

[limits]
memory_mb = 1400
cpus = 1.6
pids = 512
min_free_disk_gb = 10
cgroup_parent = "actions.slice"
# Opt-in (bead jleechan-5khv): Docker's built-in seccomp profile denies
# clone(CLONE_NEWUSER), so any CI step that isolates itself with
# `unshare -Urn` fails `Operation not permitted` inside the runner container,
# even on a host that permits user namespaces. Leave BOTH settings off to keep
# the hardened default. Prefer `seccomp_profile` (a custom JSON profile that
# allows only CLONE_NEWUSER); `allow_userns` applies `seccomp=unconfined`,
# which is broader and is a deliberate, operator-chosen isolation relaxation
# for a host that runs untrusted PR code.
#
# seccomp_profile expects a profile DERIVED FROM YOUR ENGINE'S OWN DEFAULT
# (moby/profiles seccomp/default.json at the matching release) with only the
# user-namespace clone granted. Do NOT hand-write a minimal "allow clone"
# profile: a profile is a complete whitelist, so anything omitted is BLOCKED
# and every job breaks.
# seccomp_profile = "/etc/ezgha/seccomp-userns.json"
# allow_userns = false

[policy]
# Native linux docker = container isolation. "vm" only if daemon is VM-contained
# and you want fail-closed enforcement when backend drops below vm.
minimum_isolation = "container"

# Local start failures collapse inward before they can become a fleet or VM
# restart storm. Open one slot after 3 failures in 10 minutes; pause all new
# admission only after 3 distinct slot circuits are open. Existing jobs keep
# running, and these circuits never stop Colima or the physical host.
[failure_ladder]
slot_failure_threshold = 3
slot_failure_window_secs = 600
slot_cooldown_secs = 900
fleet_open_slot_threshold = 3
fleet_cooldown_secs = 600

# Read-only auxiliary observers stay opt-in on Linux so they cannot compete
# with the core serve reconciliation loop or become host-pressure voters.
[queue_monitor]
enabled = false

[canary]
enabled = false

[invariant_sampler]
enabled = false
