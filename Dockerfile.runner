FROM ghcr.io/actions/actions-runner:latest

USER root

# Install dependencies and jq
# python3-venv/python3-pip: CI jobs create venvs; without ensurepip every
# `python3 -m venv` fails ("ensurepip is not available") and the pip
# fallback hits PEP 668 externally-managed-environment.
RUN apt-get update && apt-get install -y \
    jq \
    curl \
    git \
    python3-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Pre-bake pip at the latest version. CI workflows that `pip install`
# inside an `ENABLE_NETWORK_TESTS=0`-isolated job race against the
# daemon's startup on `pip install --upgrade pip`; pre-baking here
# removes the runtime upgrade dependency entirely. Bead jleechan-m66a.
# `|| true` so a transient PyPI failure during image build doesn't
# break the build (the bare `pip` is still usable; just not latest).
RUN python3 -m pip install --upgrade --quiet pip || true

# Install GitHub CLI (gh)
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright's Chromium + WebKit system dependencies at build time (as root).
# The workflows' own runtime fallback (apt-get download + dpkg-deb extract, for a
# non-root/no-sudo CI job user) cannot work in this image because /var/lib/apt/lists/
# is wiped by the RUN steps above to keep the image small -- apt-get download has
# nothing to resolve against at container runtime. Baking the real system libraries
# in here, while apt still has a fresh package index and we're still root, is the
# actual fix (verified via `playwright install-deps chromium webkit` + a real
# chromium/webkit launch probe against this exact base image, both as root and as
# the non-root runner user).
RUN apt-get update && python3 -m venv /opt/playwright-deps-venv \
    && /opt/playwright-deps-venv/bin/pip install --quiet playwright \
    && /opt/playwright-deps-venv/bin/python -m playwright install-deps chromium webkit \
    && rm -rf /opt/playwright-deps-venv /var/lib/apt/lists/*

# Wrap `tar` (bead jleechan-93cf follow-up): /usr/local/bin resolves ahead
# of /usr/bin in this image's PATH, so bare `tar` calls from workflow steps
# transparently go through the wrapper; the real GNU tar at /usr/bin/tar is
# untouched. See docker/tar-workspace-wrapper.sh for why (virtiofs symlink-
# extraction corruption on the workspace_host_path bind mount) and
# tests/workspace_mount_symlink_extraction_test.sh for the regression test.
COPY docker/tar-workspace-wrapper.sh /usr/local/bin/tar
RUN chmod 0755 /usr/local/bin/tar

# Run after action post steps/cache saves, while the ephemeral runner still
# owns its workspace. Never wait for the replacement runner to reclaim it.
COPY docker/runner-post-job-workspace-prune.py /usr/local/libexec/ezgha/
COPY docker/runner-post-job-workspace-prune.sh /usr/local/libexec/ezgha/
RUN chmod 0755 /usr/local/libexec/ezgha/runner-post-job-workspace-prune.sh
ENV ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/usr/local/libexec/ezgha/runner-post-job-workspace-prune.sh

# Preinstall the Node 20 runtime used by setup-node. Keep the standard runner
# tool-cache layout and ownership so setup-node can hit this version or install
# a later/missing version without writing into the workspace tmpfs.
# Hashes are from https://nodejs.org/dist/v20.20.2/SHASUMS256.txt.
ARG TARGETARCH
ENV RUNNER_TOOL_CACHE=/opt/hostedtoolcache
RUN set -eux; \
    target_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$target_arch" in \
      amd64) node_arch=x64; node_sha256=19e56f0825510207dd904f087fe52faa0a4eb6b2aab5f0ea7a33830d04888b8b ;; \
      arm64) node_arch=arm64; node_sha256=47ef73d543ecf6eb19435f6c03a0ac4809b3bf0dd6b26c7c571efc2a6572a74d ;; \
      *) echo "unsupported target architecture: $target_arch" >&2; exit 1 ;; \
    esac; \
    node_archive="node-v20.20.2-linux-${node_arch}.tar.gz"; \
    curl -fsSL "https://nodejs.org/dist/v20.20.2/${node_archive}" -o "/tmp/${node_archive}"; \
    echo "${node_sha256}  /tmp/${node_archive}" | sha256sum -c -; \
    node_path="${RUNNER_TOOL_CACHE}/node/20.20.2/${node_arch}"; \
    mkdir -p "$node_path"; \
    tar -xzf "/tmp/${node_archive}" --strip-components=1 -C "$node_path"; \
    touch "${RUNNER_TOOL_CACHE}/node/20.20.2/${node_arch}.complete"; \
    chown -R runner:runner "$RUNNER_TOOL_CACHE"; \
    rm "/tmp/${node_archive}"

USER runner
